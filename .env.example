# --- vPIC API (NHTSA) — public, no key required ---
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
VPIC_CACHE_TTL_SECONDS=86400
VPIC_CACHE_MAXSIZE=8192
VPIC_TIMEOUT_SECONDS=30

# --- Transport: "stdio" (local Claude Desktop) or "http" (hosted) ---
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=3034

# --- OAuth (HTTP transport only) ---
# Public URL — must match what clients see. Used by OAuth issuer metadata.
MCP_BASE_URL=https://vin.nlma.io
# Operator password — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Kept as a break-glass fallback alongside Google sign-in (see below).
MCP_OWNER_PASSWORD=replace_me
# OAuth state dir (registered clients, tokens). Persisted JSON.
MCP_OAUTH_STATE_DIR=/var/lib/vin-mcp/oauth-state
# Comma-separated redirect URI host allowlist
MCP_OAUTH_REDIRECT_DOMAINS=claude.ai,claude.com,chatgpt.com,openai.com,localhost

# --- Google sign-in gate (optional) ---
# Set these to offer "Sign in with Google" on /login. Use a *web* OAuth client
# whose authorized redirect URI includes <MCP_BASE_URL>/oauth/google/callback.
# vin requests only `openid email` (no Google API access).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Defaults to <MCP_BASE_URL>/oauth/google/callback when left blank.
GOOGLE_OAUTH_REDIRECT_URI=
# Comma-separated allow list of Google emails permitted to sign in. Required
# for Google sign-in to admit anyone (the gate fails closed when empty).
GOOGLE_ALLOWED_EMAILS=
# Keep the operator password working as a break-glass fallback (true/false).
ALLOW_PASSWORD_FALLBACK=true

LOG_LEVEL=INFO
LOG_FORMAT=json
